        <Param val="# Code Component &quot;znacznik_resp&quot; – Each Frame (komponent POD klawiaturą werdykt_klaw)&amp;#10;lsl_tick()&amp;#10;if werdykt_klaw.keys and not resp_wyslany:&amp;#10;    znacznik('resp', trial=trial, klawisz=werdykt_klaw.keys,&amp;#10;             poprawny=int(werdykt_klaw.keys == poprawny_klawisz))&amp;#10;    resp_wyslany = True&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
