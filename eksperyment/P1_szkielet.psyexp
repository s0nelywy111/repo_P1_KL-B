        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="constant" name="stopWithRoutine"/>
        <Param val="False" valType="bool" updates="None" name="syncScreenRefresh"/>
      </EyetrackerRecordComponent>
      <CodeComponent name="znaczniki_proby" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Code Component &quot;znaczniki_proby&quot; (rutyna: proba) – Begin Routine&amp;#10;# Komponent musi być OSTATNI w rutynie (pod karta), żeby stim:onset trafił na flip karty.&amp;#10;stim_wyslany = False&amp;#10;if trials.thisN == 0:&amp;#10;    # początek części głównej = start eksperymentu w zapisie (LabRecorder już nagrywa)&amp;#10;    znacznik_na_flip('exp:start', uczestnik=expInfo['participant'], lista='L1')&amp;#10;znacznik_na_flip('trial:start', trial=trial, blok=blok, temat=temat,&amp;#10;                 sprawca=sprawca, weryfikacja=weryfikacja, wersja=wersja)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# Code Component &quot;znaczniki_proby&quot; – Each Frame&amp;#10;lsl_tick()&amp;#10;if not stim_wyslany and karta.status == STARTED:&amp;#10;    # karta właśnie wystartowała w tej klatce -&gt; znacznik na flip, w którym pojawi się na ekranie&amp;#10;    znacznik_na_flip('stim:onset', trial=trial, obraz=obraz)&amp;#10;    stim_wyslany = True&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# Code Component &quot;znaczniki_proby&quot; – End Routine&amp;#10;znacznik('stim:offset', trial=trial, czytanie_s=round(klaw_karta.rt, 3) if klaw_karta.rt else 'limit')&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="znaczniki_proby" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
